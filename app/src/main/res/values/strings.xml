    <string name="faq_nostr_q">What is Nostr?</string>
    <string name="faq_nostr_before">Nostr is\u0020</string>
    <string name="faq_nostr_link">an open protocol</string>
    <string name="faq_nostr_after">\u0020with a chance of working. A simple standard that defines a scalable architecture of clients and servers that can be used to spread information freely. Anyone can build on it, and anyone can use it.</string>
    <string name="faq_why_q">Why Boris?</string>
    <string name="faq_why_before">Boris is the reading app I always wanted to have. I had\u0020</string>
    <string name="faq_why_idea">this idea</string>
    <string name="faq_why_for">\u0020for\u0020</string>
    <string name="faq_why_reading_app">a reading app</string>
    <string name="faq_why_middle">\u0020for a long time, and now I finally sat down and built it. The name comes from\u0020</string>
    <string name="faq_why_name">a hallucinated answer</string>
    <string name="faq_why_after">\u0020to the question \"Who invented the highlight marker?\".</string>
    <string name="faq_privacy_q">What about privacy?</string>
    <string name="faq_privacy_before">Boris is a nostr client, which means that all highlights and annotations are public by default. While nostr supports private bookmarks, your highlights and annotations are public, just like your notes and posts. Boris adheres to\u0020</string>
    <string name="faq_privacy_link">NIP-84</string>
    <string name="faq_privacy_after">\u0020and publishes highlights and annotations to your relays.</string>
    <string name="settings_about_blurb">Boris is a nostr-native reader for highlighting and calm long-form reading. Free and open source.</string>
